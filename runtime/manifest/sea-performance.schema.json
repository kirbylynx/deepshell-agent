{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "target", "dshVersion", "nodeVersion", "seaSha256", "environment", "groups", "nativeProbes", "gates", "passed"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "target": { "enum": ["darwin-arm64", "win32-x64"] },
    "dshVersion": { "type": "string", "minLength": 1 },
    "nodeVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "seaSha256": { "$ref": "#/$defs/sha256" },
    "environment": {
      "type": "object",
      "required": ["os", "arch", "browser", "runs", "freshRuns", "idleSeconds"],
      "properties": {
        "os": { "enum": ["darwin", "win32"] },
        "arch": { "enum": ["arm64", "x64"] },
        "browser": { "type": "string", "minLength": 1, "maxLength": 128 },
        "runs": { "type": "integer", "minimum": 1 },
        "freshRuns": { "type": "integer", "minimum": 1 },
        "idleSeconds": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "groups": {
      "type": "object",
      "required": ["standard", "seaFirstCache", "seaWarm", "seaFreshAppData"],
      "properties": {
        "standard": { "$ref": "#/$defs/group" },
        "seaFirstCache": { "$ref": "#/$defs/group" },
        "seaWarm": { "$ref": "#/$defs/group" },
        "seaFreshAppData": { "$ref": "#/$defs/group" }
      },
      "additionalProperties": false
    },
    "nativeProbes": {
      "type": "object",
      "required": ["probes", "first", "second", "fileCountUnchanged", "contentSizeUnchanged", "passed"],
      "properties": {
        "probes": {
          "type": "array",
          "minItems": 9,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "first": { "$ref": "#/$defs/metrics" },
        "second": { "$ref": "#/$defs/metrics" },
        "fileCountUnchanged": { "type": "boolean" },
        "contentSizeUnchanged": { "type": "boolean" },
        "passed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "object",
      "required": ["warmReady", "firstCacheReady", "warmRss"],
      "properties": {
        "warmReady": { "$ref": "#/$defs/gate" },
        "firstCacheReady": { "$ref": "#/$defs/gate" },
        "warmRss": { "$ref": "#/$defs/gate" }
      },
      "additionalProperties": false
    },
    "passed": { "type": "boolean" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "metrics": {
      "type": "object",
      "required": ["files", "bytes", "allocatedBytes"],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "allocatedBytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "sample": {
      "type": "object",
      "required": ["sample", "readyGateMs", "rssKiB", "cache", "proxy"],
      "properties": {
        "sample": { "type": "integer", "minimum": 1 },
        "readyGateMs": { "type": "number", "exclusiveMinimum": 0 },
        "rssKiB": { "type": "integer", "minimum": 1 },
        "cache": { "$ref": "#/$defs/metrics" },
        "proxy": { "$ref": "#/$defs/metrics" }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["median", "max"],
      "properties": {
        "median": { "type": "number", "exclusiveMinimum": 0 },
        "max": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "required": ["samples", "readyGateMs", "rssKiB"],
      "properties": {
        "samples": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sample" } },
        "readyGateMs": { "$ref": "#/$defs/summary" },
        "rssKiB": { "$ref": "#/$defs/summary" }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": ["baseline", "candidate", "delta", "percent", "percentLimit", "absoluteLimit", "passed"],
      "properties": {
        "baseline": { "type": "number" },
        "candidate": { "type": "number" },
        "delta": { "type": "number" },
        "percent": { "type": ["number", "null"] },
        "percentLimit": { "type": "number", "minimum": 0 },
        "absoluteLimit": { "type": "number", "minimum": 0 },
        "passed": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
