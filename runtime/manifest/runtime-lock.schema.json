{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "applicationVersion", "packageBaselineVersion", "platforms", "node", "dsh", "sea", "tooling", "security"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "applicationVersion": { "const": "0.1.5" },
    "packageBaselineVersion": { "const": "0.1.4" },
    "platforms": {
      "type": "array",
      "items": { "enum": ["darwin-arm64", "win32-x64"] },
      "minItems": 2,
      "uniqueItems": true,
      "contains": { "const": "darwin-arm64" }
    },
    "node": {
      "type": "object",
      "required": ["version", "targets"],
      "properties": {
        "version": { "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "targets": {
          "type": "object",
          "required": ["darwin-arm64", "win32-x64"],
          "properties": {
            "darwin-arm64": { "$ref": "#/$defs/nodeTarget" },
            "win32-x64": { "$ref": "#/$defs/nodeTarget" }
          },
          "additionalProperties": false
        }
      }
    },
    "dsh": {
      "type": "object",
      "required": ["package", "version", "integrity", "entry", "profile", "desktopBundle", "patches"],
      "properties": {
        "package": { "const": "@deepseek-ai/dsh" },
        "version": { "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-rc\\.[0-9]+$" },
        "integrity": { "pattern": "^sha512-" },
        "entry": { "type": "string" },
        "profile": { "const": "web" },
        "desktopBundle": { "const": "@deepshell-agent/dsh-desktop" },
        "patches": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "required": ["package", "version", "path", "sha256", "upstream"],
              "properties": {
                "package": { "const": "@deepseek-ai/dsh-client-modules" },
                "version": { "const": "0.1.5-rc.2" },
                "path": { "const": "patches/@deepseek-ai__dsh-client-modules@0.1.5-rc.2.patch" },
                "sha256": { "pattern": "^[a-f0-9]{64}$" },
                "upstream": { "const": "https://github.com/deepseek-ai/deepseek-harness/discussions/5628" }
              },
              "additionalProperties": false
            }
          ],
          "items": false
        }
      }
    },
    "sea": {
      "type": "object",
      "required": ["packager", "mode", "compression", "useSnapshot", "transforms", "targets"],
      "properties": {
        "packager": {
          "type": "object",
          "required": ["package", "version", "integrity", "shasum", "patch"],
          "properties": {
            "package": { "const": "@yao-pkg/pkg" },
            "version": { "const": "6.22.0" },
            "integrity": { "pattern": "^sha512-" },
            "shasum": { "pattern": "^[a-f0-9]{40}$" },
            "patch": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": { "const": "patches/@yao-pkg__pkg@6.22.0.patch" },
                "sha256": { "pattern": "^[a-f0-9]{64}$" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "mode": { "const": "enhanced" },
        "compression": { "const": "Zstd" },
        "useSnapshot": { "const": false },
        "transforms": {
          "type": "array",
          "prefixItems": [{ "const": "node-pty-spawn-helper-v1" }],
          "items": false
        },
        "targets": {
          "type": "object",
          "required": ["darwin-arm64", "win32-x64"],
          "properties": {
            "darwin-arm64": { "const": "node24.20.0-macos-arm64" },
            "win32-x64": { "const": "node24.20.0-win-x64" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "nodeTarget": {
      "type": "object",
      "required": ["url", "sha256", "archiveType", "executable"],
      "properties": {
        "url": { "pattern": "^https://nodejs\\.org/" },
        "sha256": { "pattern": "^[a-f0-9]{64}$" },
        "archiveType": { "enum": ["tar.gz", "zip"] },
        "executable": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
