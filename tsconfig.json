{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals", "vite/client", "node", "@wdio/globals/types"]
  },
  "include": ["src-bootstrap/**/*.ts", "tests/**/*.ts", "vite.config.ts", "wdio.conf.ts"]
}
